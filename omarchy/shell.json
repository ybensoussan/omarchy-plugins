{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "yonathan.workspaces"
        },
        {
          "id": "yonathan.workspace-backgrounds"
        }
      ],
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "yonathan.next-meeting"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "yonathan.monitor-profile"
        },
        {
          "id": "yonathan.tray"
        },
        {
          "id": "bw-vault"
        },
        {
          "id": "jankeesvw.notification-center"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "yonathan.displays"
    },
    {
      "id": "yonathan.workspace-launcher"
    },
    {
      "id": "yonathan.remmina-launcher"
    },
    {
      "id": "yonathan.nag"
    },
    {
      "id": "bw-vault"
    }
  ]
}
